{
  "rules": {
    ".read": false,
    ".write": false,
    "poems": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "categoryId",
        "featured",
        "isPublished"
      ],
      "$poemId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'",
        "views": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)",
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "likes": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)",
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "shares": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)",
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "saves": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)",
          ".validate": "newData.isNumber() && newData.val() >= 1"
        }
      }
    },
    "categories": {
      ".read": true,
      "$categoryId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
      }
    },
    "poets": {
      ".read": true,
      "$poetId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'",
      ".write": false
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "comments": {
      ".read": true,
      "$poemId": {
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && root.child('admins').child(auth.uid).child('role').val() == 'admin'))",
          ".validate": "newData.hasChildren(['uid','displayName','text','createdAt'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 28"
          },
          "likes": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && (!newData.exists() || newData.val() == true)",
              ".validate": "newData.isBoolean()"
            }
          },
          "adminReply": {
            ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'",
            ".validate": "newData.hasChildren(['text','adminUid','adminName','createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        }
      }
    },
    "reports": {
      "$poemId": {
        ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'",
        "$reportId": {
          ".write": "auth != null && newData.child('uid').val() == auth.uid",
          ".validate": "newData.hasChildren(['uid','displayName','reason','status','createdAt'])"
        }
      }
    },
    "gallery": {
      ".read": true,
      "$imageId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
      }
    }
  }
}