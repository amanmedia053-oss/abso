{
  "rules": {
    ".read": true,
    ".write": false,
    "poems": {
      ".indexOn": [
        "createdAt",
        "categoryId",
        "featured",
        "isPublished"
      ],
      "$poemId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'",
        "views": {
          ".write": "newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)",
          ".validate": "newData.isNumber() && newData.val() >= 1"
        }
      }
    },
    "categories": {
      "$categoryId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
      }
    },
    "poets": {
      "$poetId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('role').val() == 'admin'",
      ".write": false
    }
  }
}
